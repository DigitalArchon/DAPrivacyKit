# The AppImage build environment: Ubuntu 24.04 pinned by digest, packages from a dated archive
# snapshot. The host's CA bundle comes in as /hostca.crt, a copy build-appimage.sh puts in the
# build context (never a mount of the host's own file: on an SELinux host a mount needs :Z, which
# rootless Podman can't apply to a file root owns, and rootful Podman would relabel the system's
# bundle), only so apt can reach the snapshot over HTTPS until ca-certificates is installed, and
# is removed again; packages are verified by apt's signatures. (The copy stays in a layer of this
# builder image, which never leaves the machine.)
#
# zsync makes the .zsync file an AppImage updater reads to fetch only what changed; readelf
# (binutils, which gcc brings) finds the runtime's section for the update information.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG APT_SNAPSHOT
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 TZ=UTC
COPY hostca.crt /hostca.crt
RUN rm -f /etc/apt/sources.list && printf '%s\n' \
      'Types: deb' \
      "URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}/" \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' > /etc/apt/sources.list.d/ubuntu.sources \
 && echo 'Acquire::https::CaInfo "/hostca.crt";' > /etc/apt/apt.conf.d/99hostca \
 && apt-get update -o Acquire::Retries=3 \
 && apt-get install -y --no-install-recommends -o Acquire::Retries=3 \
      ca-certificates curl gcc libc6-dev pkg-config \
      libgirepository-2.0-dev libcairo2-dev libffi-dev gir1.2-freedesktop \
      squashfs-tools desktop-file-utils zsync \
 && rm /etc/apt/apt.conf.d/99hostca /hostca.crt \
 && rm -rf /var/lib/apt/lists/*
